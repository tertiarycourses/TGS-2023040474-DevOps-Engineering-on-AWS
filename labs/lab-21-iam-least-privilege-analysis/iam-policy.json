{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeastPrivilegeAppData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::devops-sample-app-data/*"
    },
    {
      "Sid": "ReadOwnLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/devops/app:*"
    },
    {
      "Sid": "ReadOwnAppParameter",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/devops/app/*"
    }
  ]
}
